    },
    "api/research.js": {
      "maxDuration": 300
    },
    "api/etsy.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/design/fonts/*.ttf,node_modules/pdfkit/js/data/*.afm,node_modules/pdfkit/js/data/*.icc}"
    },
    "api/etsy-sync.js": {
      "maxDuration": 120
    },
    "api/autopilot.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/design/fonts/*.ttf,node_modules/pdfkit/js/data/*.afm,node_modules/pdfkit/js/data/*.icc}"
    },
    "api/preview.js": {
      "maxDuration": 120,
      "includeFiles": "{lib/design/fonts/*.ttf,node_modules/pdfkit/js/data/*.afm,node_modules/pdfkit/js/data/*.icc}"
    },
    "api/data.js": {
      "maxDuration": 30
    },
    "api/marketing.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/design/fonts/*.ttf,node_modules/pdfkit/js/data/*.afm,node_modules/pdfkit/js/data/*.icc}"
