      "maxDuration": 300,
      "includeFiles": "{lib/design/fonts/*.ttf,node_modules/pdfkit/js/data/*.afm,node_modules/pdfkit/js/data/*.icc,node_modules/ffmpeg-static/ffmpeg}"
