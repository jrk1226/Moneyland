{
  "functions": {
    "api/ai.js": { "maxDuration": 90 },
    "api/produce.js": { "maxDuration": 300 },
    "api/research.js": { "maxDuration": 300 },
    "api/etsy.js": { "maxDuration": 120, "includeFiles": "api/*.ttf" },
