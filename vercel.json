    "api/autopilot.js": { "maxDuration": 300, "includeFiles": "api/*.ttf" }
  },
  "crons": [
    { "path": "/api/research", "schedule": "40 * * * *" },
    { "path": "/api/autopilot", "schedule": "10 * * * *" },
    { "path": "/api/etsy-sync", "schedule": "*/15 * * * *" }
  ]
}
