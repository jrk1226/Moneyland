  "crons": [
    {
      "path": "/api/research",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/autopilot",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/etsy-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/marketing?do=cron",
      "schedule": "5-59/10 * * * *"
    },
    {
      "path": "/api/studio",
      "schedule": "7-59/15 * * * *"
    },
    {
      "path": "/api/health",
      "schedule": "3-59/15 * * * *"
